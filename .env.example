# Copie para .env (ignorado pelo git) ou defina no ambiente/agendador. NUNCA versione valores reais.

# --- YouTube (somente quando o upload for autorizado) ---
# Cliente OAuth tipo "App para computador" criado no Google Cloud Console (YouTube Data API v3 ativada).
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# Opcional: refresh token direto (para execucao agendada). Sem ele, usa o arquivo de config.youtube.tokenFile.
YT_REFRESH_TOKEN=

# --- Provedores pagos (desligados por padrao; exigem budget.maxUsdPerEpisode > 0 em config/channel.json) ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# --- Opcionais ---
# Caminho de um Chromium/headless shell ja instalado (senao o Remotion baixa o seu).
REMOTION_BROWSER_EXECUTABLE=
# Python com as dependencias de python/requirements.txt (padrao: .venv/bin/python)
DNN_PYTHON=
